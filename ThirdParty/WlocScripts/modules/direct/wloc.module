#!name=Apple WLOC 定位修改
#!desc=Apple 网络定位修改 | 使用说明: https://github.com/ljphawk/location-spoofer-scripts/blob/main/docs/THIRD_PARTY_MODULES.md
#!author=Yu9191 Rewrite
#!homepage=https://github.com/ljphawk/location-spoofer-scripts
#!category=Tools

[Script]
Apple WLOC = type=http-response,pattern=^https?:\/\/(?:gs-loc(?:-cn)?\.apple\.com|gsp-ssl\.ls\.apple\.com|bluedot\.is\.autonavi\.com(?:\.gds\.alibabadns\.com)?)\/clls\/wloc,requires-body=1,binary-body-mode=1,max-size=0,timeout=30,script-path=https://raw.githubusercontent.com/ljphawk/location-spoofer-scripts/main/ThirdParty/WlocScripts/dist/v2/wloc.js?v=1.0.9-control1,argument=logLevel=info
WLOC Settings = type=http-request,pattern=^https?:\/\/(?:wloc-control\.invalid|gs-loc(-cn)?\.apple\.com)\/wloc-settings\/save,requires-body=0,max-size=0,timeout=10,script-path=https://raw.githubusercontent.com/ljphawk/location-spoofer-scripts/main/ThirdParty/WlocScripts/dist/v2/wloc-settings.js?v=1.0.9-control1

[MITM]
hostname = %APPEND% wloc-control.invalid, gs-loc.apple.com, gs-loc-cn.apple.com, gsp-ssl.ls.apple.com, bluedot.is.autonavi.com, bluedot.is.autonavi.com.gds.alibabadns.com

[Host]
wloc-control.invalid = 192.0.2.1

[Rule]
DOMAIN,wloc-control.invalid,DIRECT
