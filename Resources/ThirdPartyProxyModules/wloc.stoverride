name: Apple WLOC 定位修改
desc: "Apple 网络定位修改 | 使用说明: https://github.com/ljphawk/location-spoofer-scripts/blob/main/docs/THIRD_PARTY_MODULES.md"
author: Yu9191 Rewrite
homepage: https://github.com/ljphawk/location-spoofer-scripts
category: Tools

hosts:
  "wloc-control.invalid": 192.0.2.1
rules:
  - DOMAIN,wloc-control.invalid,DIRECT

http:
  mitm:
    - "wloc-control.invalid"
    - "gs-loc.apple.com"
    - "gs-loc-cn.apple.com"
    - "gsp-ssl.ls.apple.com"
    - "bluedot.is.autonavi.com"
    - "bluedot.is.autonavi.com.gds.alibabadns.com"
  script:
    - match: ^https?:\/\/(?:gs-loc(?:-cn)?\.apple\.com|gsp-ssl\.ls\.apple\.com|bluedot\.is\.autonavi\.com(?:\.gds\.alibabadns\.com)?)\/clls\/wloc
      name: WLOC.Location
      type: response
      require-body: true
      binary-mode: true
      max-size: 0
      timeout: 30
      argument: logLevel=info
    - match: ^https?:\/\/(?:wloc-control\.invalid|gs-loc(-cn)?\.apple\.com)\/wloc-settings\/save
      name: WLOC.Settings
      type: request
      require-body: false
      timeout: 10

script-providers:
  WLOC.Location:
    url: https://gh-proxy.org/https://raw.githubusercontent.com/ljphawk/location-spoofer-scripts/codex/local-control-endpoint/ThirdParty/WlocScripts/dist/v2/wloc.js?v=1.0.9-control2
    interval: 86400
  WLOC.Settings:
    url: https://gh-proxy.org/https://raw.githubusercontent.com/ljphawk/location-spoofer-scripts/codex/local-control-endpoint/ThirdParty/WlocScripts/dist/v2/wloc-settings.js?v=1.0.9-control2
    interval: 86400
